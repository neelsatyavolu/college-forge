    { "key": "merit_aid", "value": "Yes, no separate application: every freshman application is reviewed for merit (with or without scores) if received by Nov 1 (EA) or Jan 15. Typical awards: Trustee $16-17k, Presidential $14-16k, Provost $10-15k, Delaware Scholar $8-10k per year", "sourceUrl": "https://www.udel.edu/apply/undergraduate-admissions/financing-your-degree/out-of-state-freshmen", "checkedAt": "2026-11-25", "cycle": "2026-27", "thirdParty": false },
