# Optional fallback AI provider (used only if neither Grok nor ChatGPT is connected)
OPENCODE_API_KEY=

# Web research for the copilot (max quality: set BOTH)
# Exa — neural search + page excerpts  https://dashboard.exa.ai/api-keys
EXA_API_KEY=
# WEB_SEARCH_API_KEY=   # optional alias for EXA_API_KEY
#
# TinyFish — free Search + Fetch (deep-read pages)  https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=

# Required on Vercel production (auto-injected when you create a private Blob store)
# BLOB_READ_WRITE_TOKEN=

# Optional: relocate the local workspace data store
# CF_DATA_DIR=/var/data/college-forge

# College Scorecard (optional; public API often works without a key for light use)
# COLLEGE_SCORECARD_API_KEY=

# Accounts: Forge signs people in with Xanom accounts (https://accounts.xanom.co, OIDC)
# XANOM_CLIENT_ID=forge
# XANOM_CLIENT_SECRET=
# Signs session cookies, consent forms and handoff links (32+ random characters)
# SESSION_SECRET=
# Public origin used in OAuth metadata and redirects (production: https://forge.xanom.co)
# FORGE_ORIGIN=

# Applications tracker
# 32 random bytes, base64: encrypts saved portal logins. Losing it makes saved logins unreadable.
# PORTAL_LOGINS_KEY=
# Shared with the College Apps Worker's /api/service/check, which runs portal sign-ins
# FORGE_SERVICE_KEY=
# Bearer secret for /api/cron/portal-checks (also used by Vercel cron)
# CRON_SECRET=
