# Optional fallback AI provider (used only if neither Grok nor ChatGPT is connected)
OPENCODE_API_KEY=

# Optional web-search key for the copilot (Exa — see lib/web-search-tool.ts)
# EXA_API_KEY=
# WEB_SEARCH_API_KEY=

# Required on Vercel production (auto-injected when you create a private Blob store)
# BLOB_READ_WRITE_TOKEN=

# Optional: relocate the local workspace data store
# CF_DATA_DIR=/var/data/college-forge

# College Scorecard (optional; public API often works without a key for light use)
# COLLEGE_SCORECARD_API_KEY=
